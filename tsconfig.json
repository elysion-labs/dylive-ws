{
  "compilerOptions": {
    "noEmit": true,
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "customConditions": ["source"]
  },
  "include": ["src", "scripts", "examples", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
