{
  "name": "@elysionjs/dylive-ws",
  "version": "0.1.1",
  "description": "Read-only Douyin live chat decoding and Electron CDP capture.",
  "homepage": "https://github.com/elysion-labs/dylive-ws#readme",
  "bugs": {
    "url": "https://github.com/elysion-labs/dylive-ws/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elysion-labs/dylive-ws.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./protocol": {
      "source": "./src/protocol.ts",
      "types": "./dist/protocol.d.mts",
      "default": "./dist/protocol.mjs"
    },
    "./parser": {
      "source": "./src/parser.ts",
      "types": "./dist/parser.d.mts",
      "default": "./dist/parser.mjs"
    },
    "./electron": {
      "source": "./src/electron.ts",
      "types": "./dist/electron.d.mts",
      "default": "./dist/electron.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "changeset": "changeset",
    "check": "vp check",
    "example:live": "bun examples/live.ts",
    "example:parse": "bun examples/parse.ts",
    "ready": "vp check && vp run typecheck && vp run test && vp run build",
    "release": "changeset publish",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "version": "changeset version && vp install --lockfile-only && vp fmt package.json CHANGELOG.md"
  },
  "dependencies": {
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@byc/vp-config": "^0.1.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@stylistic/eslint-plugin": "^6.0.0",
    "@types/bun": "^1.4.4",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plus": "1.6.0"
  },
  "peerDependencies": {
    "electron": "*"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=24.0.0"
  },
  "packageManager": "bun@1.4.4"
}
